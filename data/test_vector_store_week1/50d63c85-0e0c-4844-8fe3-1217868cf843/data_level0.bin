    "x_mitre_platforms": [
      "Linux",
      "macOS"
    ],
    "x_mitre_version": "1.1"
  },
  {
    "type": "attack-pattern",
    "id": "attack-pattern--21875073-b0ee-49e3-9077-1e2a885359af",
    "created": "2020-02-21T21:08:26.480Z",
    "created_by_ref": "identity--c78cb6e5-0c4b-4611-8297-d1b8b55e40b5",
    "revoked": false,
    "external_references": [

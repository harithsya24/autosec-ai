  {
    "type": "attack-pattern",
    "id": "attack-pattern--1ecfdab8-7d59-4c98-95d4-dc41970f57fc",
    "created": "2020-02-21T16:22:09.493Z",
    "created_by_ref": "identity--c78cb6e5-0c4b-4611-8297-d1b8b55e40b5",
    "revoked": false,
    "external_references": [
      {
        "source_name": "mitre-attack",

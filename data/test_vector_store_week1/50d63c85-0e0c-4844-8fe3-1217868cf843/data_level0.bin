  {
    "type": "attack-pattern",
    "id": "attack-pattern--25659dd6-ea12-45c4-97e6-381e3e4b593e",
    "created": "2020-02-21T21:07:55.393Z",
    "created_by_ref": "identity--c78cb6e5-0c4b-4611-8297-d1b8b55e40b5",
